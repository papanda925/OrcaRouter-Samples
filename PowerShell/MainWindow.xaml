<Window
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="OrcaRouter PowerShell Chat Sample"
    Width="1200"
    Height="900"
    MinWidth="900"
    MinHeight="720"
    WindowStartupLocation="CenterScreen"
    WindowState="Maximized"
    ResizeMode="CanResizeWithGrip"
    UseLayoutRounding="True"
    Background="#F4F7FB"
    FontFamily="Segoe UI">
    <Window.Resources>
        <Style TargetType="TextBox">
            <Setter Property="BorderBrush" Value="#D9E1EC"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10"/>
            <Setter Property="Background" Value="#FBFDFF"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style TargetType="PasswordBox">
            <Setter Property="BorderBrush" Value="#D9E1EC"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10"/>
            <Setter Property="Background" Value="#FBFDFF"/>
        </Style>
        <Style TargetType="Button">
            <Setter Property="Padding" Value="16,9"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style TargetType="TabItem">
            <Setter Property="Padding" Value="18,9"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="14"/>
        </Style>
    </Window.Resources>

    <ScrollViewer
        x:Name="PageScrollViewer"
        VerticalScrollBarVisibility="Auto"
        HorizontalScrollBarVisibility="Disabled"
        CanContentScroll="False"
        PanningMode="VerticalOnly"
        HorizontalContentAlignment="Stretch"
        VerticalContentAlignment="Stretch">
        <Grid
            Margin="24"
            MinHeight="900">
            <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="2*" MinHeight="170"/>
            <RowDefinition Height="8"/>
            <RowDefinition Height="5*" MinHeight="320"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock
                    Text="ORCAROUTER API LEARNING SAMPLE"
                    Foreground="#0F766E"
                    FontSize="12"
                    FontWeight="Bold"/>
                <TextBlock
                    Text="PowerShell / XAML Chat"
                    Margin="0,4,0,0"
                    Foreground="#172033"
                    FontSize="34"
                    FontWeight="Bold"/>
                <TextBlock
                    Text="Chat / Streaming / Tool Calling とHTTP電文を1画面で追跡できる学習者向けサンプル"
                    Margin="0,6,0,0"
                    Foreground="#64748B"
                    FontSize="14"/>
            </StackPanel>
            <Border
                Grid.Column="1"
                Padding="12,8"
                VerticalAlignment="Center"
                Background="#FFF8DF"
                BorderBrush="#F3D27A"
                BorderThickness="1"
                CornerRadius="8">
                <TextBlock Text="APIキーはトレースに平文出力しません" Foreground="#7C5C00"/>
            </Border>
        </Grid>

        <Border
            Grid.Row="1"
            Margin="0,0,0,14"
            Padding="16"
            Background="White"
            BorderBrush="#D9E1EC"
            BorderThickness="1"
            CornerRadius="12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock Text="API key" Margin="0,0,0,6" Foreground="#64748B" FontWeight="SemiBold"/>
                    <PasswordBox x:Name="ApiKeyBox" Height="42"/>
                </StackPanel>

                <StackPanel Grid.Column="2">
                    <TextBlock Text="Model" Margin="0,0,0,6" Foreground="#64748B" FontWeight="SemiBold"/>
                    <TextBox
                        x:Name="ModelBox"
                        Height="42"
                        Text="{Binding Model, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                </StackPanel>

                <StackPanel Grid.Column="4">
                    <TextBlock Text="Mode" Margin="0,0,0,6" Foreground="#64748B" FontWeight="SemiBold"/>
                    <ComboBox
                        x:Name="ModeBox"
                        Height="42"
                        SelectedValuePath="Content"
                        SelectedValue="{Binding Mode, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}">
                        <ComboBoxItem Content="Chat"/>
                        <ComboBoxItem Content="Streaming"/>
                        <ComboBoxItem Content="Tool Calling"/>
                    </ComboBox>
                </StackPanel>
            </Grid>
        </Border>

        <Border
            Grid.Row="2"
            Margin="0,0,0,14"
            Padding="16"
            Background="White"
            BorderBrush="#D9E1EC"
            BorderThickness="1"
            CornerRadius="12">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <Grid Grid.Row="0" Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="INPUT" Foreground="#0F766E" FontSize="11" FontWeight="Bold"/>
                        <TextBlock Text="質問" FontSize="18" FontWeight="Bold"/>
                    </StackPanel>
                    <Button
                        x:Name="SendButton"
                        Grid.Column="1"
                        Content="送信"
                        MinWidth="110"
                        Background="#0F172A"
                        Foreground="White"
                        BorderBrush="#0F172A"/>
                </Grid>
                <TextBox
                    x:Name="QuestionBox"
                    Grid.Row="1"
                    MinHeight="80"
                    Padding="12"
                    FontSize="15"
                    AcceptsReturn="True"
                    AcceptsTab="True"
                    TextWrapping="Wrap"
                    VerticalScrollBarVisibility="Auto"
                    HorizontalScrollBarVisibility="Disabled"
                    VerticalContentAlignment="Top"
                    IsReadOnly="False"
                    IsEnabled="True"
                    Focusable="True"
                    IsTabStop="True"
                    IsUndoEnabled="True"
                    SpellCheck.IsEnabled="False"
                    InputMethod.IsInputMethodEnabled="True"
                    Background="White"
                    Foreground="#172033"
                    CaretBrush="#172033"
                    SelectionBrush="#B7D7FF"/>
            </Grid>
        </Border>

        <GridSplitter
            Grid.Row="3"
            Height="6"
            Margin="24,0"
            HorizontalAlignment="Stretch"
            VerticalAlignment="Center"
            Background="#D9E1EC"
            ResizeDirection="Rows"
            ResizeBehavior="PreviousAndNext"
            ShowsPreview="True"/>

        <Border
            Grid.Row="4"
            Margin="0,0,0,14"
            Padding="16"
            Background="White"
            BorderBrush="#D9E1EC"
            BorderThickness="1"
            CornerRadius="12">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <StackPanel Margin="0,0,0,10">
                    <TextBlock Text="RESULT" Foreground="#0F766E" FontSize="11" FontWeight="Bold"/>
                    <TextBlock Text="回答 / HTTPトレース" FontSize="18" FontWeight="Bold"/>
                </StackPanel>

                <TabControl
                    x:Name="ResultTabs"
                    Grid.Row="1"
                    SelectedIndex="0"
                    Background="White"
                    BorderBrush="#D9E1EC">

                    <TabItem Header="回答">
                        <Grid Margin="10">
                            <TextBox
                                x:Name="AnswerBox"
                                IsReadOnly="True"
                                AcceptsReturn="True"
                                TextWrapping="Wrap"
                                VerticalScrollBarVisibility="Auto"
                                HorizontalScrollBarVisibility="Disabled"
                                MinHeight="180"
                                VerticalContentAlignment="Top"
                                Text="{Binding Answer, Mode=OneWay}"/>
                        </Grid>
                    </TabItem>

                    <TabItem Header="トレース">
                        <Grid Margin="10">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock
                                    Text="処理ステップ / HTTP電文"
                                    Foreground="#64748B"
                                    VerticalAlignment="Center"/>
                                <Button
                                    x:Name="ClearTraceButton"
                                    Grid.Column="1"
                                    Content="クリア"
                                    MinWidth="90"
                                    Background="White"
                                    Foreground="#172033"
                                    BorderBrush="#D9E1EC"/>
                            </Grid>

                            <TextBox
                                x:Name="TraceBox"
                                Grid.Row="1"
                                IsReadOnly="True"
                                AcceptsReturn="True"
                                TextWrapping="NoWrap"
                                HorizontalScrollBarVisibility="Auto"
                                VerticalScrollBarVisibility="Auto"
                                MinHeight="180"
                                VerticalContentAlignment="Top"
                                FontFamily="Consolas"
                                FontSize="12"
                                Foreground="#D9E7FF"
                                Background="#0F172A"
                                BorderBrush="#0F172A"/>
                        </Grid>
                    </TabItem>
                </TabControl>
            </Grid>
        </Border>

        <Grid Grid.Row="5">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock
                x:Name="StatusText"
                Text="{Binding StatusText, Mode=OneWay}"
                Foreground="#64748B"
                VerticalAlignment="Center"/>
            <TextBlock
                Grid.Column="1"
                Text="Ctrl+Enter でも送信できます"
                Foreground="#94A3B8"
                VerticalAlignment="Center"/>
        </Grid>
        </Grid>
    </ScrollViewer>
</Window>
